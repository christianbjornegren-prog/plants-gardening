rules_version = '2';

// Foton delas av samma två personer som Firestore-datan. Samma lista som
// firestore.rules och src/lib/behorighet.ts.
service firebase.storage {
  match /b/{bucket}/o {

    function behorig() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             'christian.bjornegren@gmail.com',
             'elinkristinaeriksson@gmail.com'
           ];
    }

    // Både den delade roten och gamla personliga rötter — en fotoRef som
    // skrevs före delningen ska fortsätta gå att visa.
    match /users/{rot}/{allPaths=**} {
      allow read, write: if behorig();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
