rules_version = '2';

// Foton ligger under users/{uid}/photos/… Samma behörighetslista som
// firestore.rules och src/lib/behorighet.ts.
service firebase.storage {
  match /b/{bucket}/o {

    function behorig() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             'christian.bjornegren@gmail.com',
             'elinkristinaeriksson@gmail.com'
           ];
    }

    match /users/{uid}/{allPaths=**} {
      allow read, write: if behorig() && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
