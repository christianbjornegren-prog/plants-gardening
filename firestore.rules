rules_version = '2';

// Ripvägen 11 — Christian och Elin sköter SAMMA trädgård. Båda kommer åt all
// data; ingen annan kommer åt något. Listan speglas i src/lib/behorighet.ts
// och storage.rules; behorighet.test.ts bevakar att de hålls i synk.
service cloud.firestore {
  match /databases/{database}/documents {

    function behorig() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             'christian.bjornegren@gmail.com',
             'elinkristinaeriksson@gmail.com'
           ];
    }

    // Delad rot (users/delad/…) plus gamla personliga rötter, så att data
    // som skrevs innan trädgården blev gemensam går att flytta hem.
    match /users/{rot}/{document=**} {
      allow read, write: if behorig();
    }

    // Allt annat är stängt.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
