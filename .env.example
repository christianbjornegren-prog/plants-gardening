# Kopiera till .env.local och fyll i värdena från Firebase-konsolen (Projektinställningar → Allmänt).
# Utan dessa värden körs appen i LOKALT läge: all data sparas i webbläsaren (Firestore-cache).
# OBS: lokalt läge och molnläge är skilda datamängder — att fylla i värdena startar med en
# tom molndatabas. Lokal data ligger kvar i webbläsaren men flyttas inte automatiskt.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
