# Kopiera till .env.local och fyll i värdena från Firebase-konsolen (Projektinställningar → Allmänt).
# Utan dessa värden körs appen i LOKALT läge: all data sparas i webbläsaren (Firestore-cache)
# och synkas inte till molnet. Perfekt för att prova appen — fyll i när Firebase-projektet finns.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
